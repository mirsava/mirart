PORT=3001
FRONTEND_URL=http://localhost:3000

# Supabase Postgres: use the Session pooler URI (IPv4 compatible) from Project Settings -> Database.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth (Project Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
SHIPPO_API_KEY=

# Email (Resend HTTPS API; works on hosts that block SMTP). Leave the key empty to log emails instead of sending.
RESEND_API_KEY=
EMAIL_FROM=ArtZyla <noreply@yourdomain.com>
